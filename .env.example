# Copy this file to .env and replace the placeholder values.
# Never commit the real .env file.

NODE_ENV=development
PORT=5000

# MongoDB connection string.
# Local example: mongodb://127.0.0.1:27017/nestfind
# Atlas example: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/nestfind?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/nestfind

# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS. Comma-separate multiple origins if needed.
CLIENT_URL=http://localhost:5173

# Set to 1 when running behind a reverse proxy (Render, Heroku, nginx) so rate limiting sees real IPs.
TRUST_PROXY=

# lax is correct when the app is served from the same site (including the Vite dev proxy).
# Use none only for cross-site production deployments over HTTPS.
COOKIE_SAMESITE=lax

# Geocoding. Nominatim (OpenStreetMap) works without an API key.
# Respect their usage policy: https://operations.osmfoundation.org/policies/nominatim/
GEOCODING_PROVIDER=nominatim
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=NestFind/1.0 (your-email@example.com)

# Optional Cloudinary image storage. Leave blank to store uploads on local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=nestfind